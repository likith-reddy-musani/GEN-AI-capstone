# Nexus AI Configuration
# Copy this file to .env and fill in your actual credentials

# Your Nexus AI API key (required)
NEXUS_API_KEY=your-api-key-here

# Nexus AI API base URL (optional, defaults to https://nexusapi.navigatelabs.ai)
BASE_URL=https://nexusapi.navigatelabs.ai

# Model name to use (optional, defaults to nova-micro)
MODEL_NAME=nova-micro

# Embedding model name (optional, defaults to text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small
